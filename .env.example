# Shared
NODE_ENV=development
PORT=4000

# Supabase
# Supabase DB for Prisma
# Use Supabase pooler URL (typically port 6543) for runtime queries.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Use direct DB URL (typically port 5432) for Prisma migrations.
SUPABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=job-media

# Telegram bots (both bots run inside the API process)
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_ARTISAN_BOT_TOKEN=
# polling (local dev) or webhook (production)
BOT_MODE=polling
CUSTOMER_BOT_WEBHOOK_PATH=/webhooks/customer
ARTISAN_BOT_WEBHOOK_PATH=/webhooks/artisan

# OpenRouter / Gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash

# Public-facing HTTPS base URL of this deployment (no trailing slash).
# When set, the API registers Telegram webhooks automatically on startup
# and enables the one-click Auto-setup button in the admin dashboard.
# Leave blank to use polling mode locally.
PUBLIC_BASE_URL=

# Web admin client
VITE_API_BASE_URL=http://localhost:4000

# Admin app auth
ADMIN_EMAIL=admin@fixfinder.local
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
